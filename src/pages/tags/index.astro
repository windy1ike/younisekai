---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TEXT } from '../../consts';
import { sortByDate, tagCounts, tagUrl, visiblePosts } from '../../utils/post';

const posts = sortByDate(visiblePosts(await getCollection('posts')));
const tags = tagCounts(posts);
const max = tags[0]?.count ?? 1;
---

<BaseLayout title={TEXT.tagsTitle} description={TEXT.tagsMeta}>
  <div class="container section">
    <h1 class="page-title">{TEXT.tagsTitle}</h1>
    <p class="page-desc">{TEXT.tagsCount(tags.length)}</p>

    {
      tags.length === 0 ? (
        <p class="empty">{TEXT.tagsEmpty}</p>
      ) : (
        <ul class="tag-cloud">
          {tags.map(({ tag, count }) => (
            <li>
              <a class="tag tag--cloud" href={tagUrl(tag)} style={`--weight:${count / max}`}>
                {tag}
                <span class="tag__count">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<style>
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: center; /* 字号不同的标签在同一行里按中心对齐 */
    gap: 0.6rem;
    list-style: none;
    padding: 0;
  }

  /* li 不跟着拉伸，否则同一行里字号小的标签会贴着顶部 */
  .tag-cloud li {
    display: flex;
  }

  .tag--cloud {
    padding: 0.3rem 0.85rem;
    font-size: calc(0.85rem + var(--weight, 0) * 0.35rem);
    gap: 0.4rem;
  }

  .tag__count {
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    font-size: 0.75em;
  }
</style>
