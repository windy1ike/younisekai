---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, TEXT } from '../consts';
import { withBase } from '../utils/url';
import { sortByDate, visiblePosts } from '../utils/post';

const posts = sortByDate(visiblePosts(await getCollection('posts')));
const recent = posts.slice(0, SITE.postsPerPage);
const total = posts.length;
---

<BaseLayout>
  <div class="container section">
    <section class="hero">
      <h1 class="hero__title">{SITE.title}</h1>
      <p class="hero__desc">{SITE.description}</p>
      <p class="hero__count">{TEXT.homeCount(total)}</p>
    </section>

    <h2 class="section-heading">
      {recent.length === total ? TEXT.homeAllPosts : TEXT.homeRecentPosts}
      <a class="section-heading__more" href={withBase('/archive/')}>{TEXT.homeArchiveLink}</a>
    </h2>

    {
      recent.length > 0 ? (
        <ul class="post-list">
          {recent.map((post) => (
            <PostCard post={post} />
          ))}
        </ul>
      ) : (
        <p class="empty">{TEXT.homeEmpty}</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .hero {
    padding-block: 2rem 2.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }

  .hero__title {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 2.75rem);
    letter-spacing: -0.03em;
    margin-bottom: 0.6rem;
  }

  .hero__desc {
    font-size: 1.1rem;
    color: var(--text-soft);
    max-width: 34rem;
  }

  .hero__count {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-size: 1.05rem;
    margin-bottom: 0.75rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .section-heading__more {
    margin-left: auto;
    font-size: 0.85rem;
    font-weight: 400;
  }
</style>
