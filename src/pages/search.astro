---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, TEXT } from '../consts';
---

<BaseLayout title={TEXT.searchTitle} description={TEXT.searchMeta}>
  <div class="container section">
    <h1 class="page-title">{TEXT.searchTitle}</h1>
    <p class="page-desc">{TEXT.searchDesc}</p>

    <div class="search-box">
      <svg
        class="search-box__icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder={TEXT.searchPlaceholder}
        autocomplete="off"
        spellcheck="false"
        aria-label={TEXT.searchInputLabel}
      />
    </div>

    <p class="search-status" id="search-status" role="status" aria-live="polite"></p>
    <ul class="post-list" id="search-results"></ul>
  </div>
</BaseLayout>

<script>
  import { SITE, TEXT } from '../consts';

  interface IndexItem {
    title: string;
    url: string;
    date: string;
    dateLabel: string;
    tags: string[];
    excerpt: string;
    text: string;
  }

  const input = document.querySelector<HTMLInputElement>('#search-input');
  const status = document.querySelector<HTMLElement>('#search-status');
  const results = document.querySelector<HTMLElement>('#search-results');

  let index: IndexItem[] | null = null;

  async function loadIndex(): Promise<IndexItem[]> {
    if (!index) {
      const response = await fetch(`${import.meta.env.BASE_URL}search.json`);
      index = (await response.json()) as IndexItem[];
    }
    return index;
  }

  function escapeRegExp(value: string): string {
    return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  /** 把命中的关键词包进 <mark>，用 DOM 构造，天然不会有 XSS 问题 */
  function highlight(text: string, terms: string[]): DocumentFragment {
    const fragment = document.createDocumentFragment();
    if (terms.length === 0) {
      fragment.append(text);
      return fragment;
    }
    const pattern = new RegExp(`(${terms.map(escapeRegExp).join('|')})`, 'gi');
    let last = 0;
    for (const match of text.matchAll(pattern)) {
      const start = match.index ?? 0;
      if (start > last) fragment.append(text.slice(last, start));
      const mark = document.createElement('mark');
      mark.textContent = match[0];
      fragment.append(mark);
      last = start + match[0].length;
    }
    fragment.append(text.slice(last));
    return fragment;
  }

  /** 取命中位置附近的正文片段 */
  function snippet(item: IndexItem, terms: string[]): string {
    const source = item.text || item.excerpt;
    if (terms.length === 0) return item.excerpt;
    const lower = source.toLowerCase();
    let at = -1;
    for (const term of terms) {
      const found = lower.indexOf(term.toLowerCase());
      if (found !== -1 && (at === -1 || found < at)) at = found;
    }
    if (at === -1) return item.excerpt;
    const start = Math.max(0, at - 40);
    const end = Math.min(source.length, at + 90);
    return `${start > 0 ? '…' : ''}${source.slice(start, end)}${end < source.length ? '…' : ''}`;
  }

  function score(item: IndexItem, terms: string[]): number {
    const title = item.title.toLowerCase();
    const tags = item.tags.join(' ').toLowerCase();
    const body = `${item.excerpt} ${item.text}`.toLowerCase();
    let total = 0;
    for (const term of terms) {
      const t = term.toLowerCase();
      if (title.includes(t)) total += 12;
      if (tags.includes(t)) total += 5;
      const hits = body.split(t).length - 1;
      if (hits > 0) total += Math.min(hits, 5);
    }
    return total;
  }

  function renderCard(item: IndexItem, terms: string[]): HTMLLIElement {
    const card = document.createElement('li');
    card.className = 'post-card';

    const heading = document.createElement('h2');
    heading.className = 'post-card__title';
    const link = document.createElement('a');
    link.href = item.url;
    link.append(highlight(item.title, terms));
    heading.append(link);

    const desc = document.createElement('p');
    desc.className = 'post-card__desc';
    desc.append(highlight(snippet(item, terms), terms));

    const meta = document.createElement('div');
    meta.className = 'post-meta';
    const time = document.createElement('time');
    time.dateTime = item.date;
    time.textContent = item.dateLabel;
    meta.append(time);

    card.append(heading, desc, meta);

    if (item.tags.length > 0) {
      const list = document.createElement('ul');
      list.className = 'tag-list post-card__tags';
      for (const tag of item.tags) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.className = 'tag';
        a.href = `${import.meta.env.BASE_URL}tags/${encodeURIComponent(tag)}/`;
        a.textContent = tag;
        li.append(a);
        list.append(li);
      }
      card.append(list);
    }

    return card;
  }

  async function runSearch(query: string): Promise<void> {
    if (!status || !results) return;
    const terms = query.trim().split(/\s+/).filter(Boolean);

    if (terms.length === 0) {
      results.replaceChildren();
      status.textContent = '';
      return;
    }

    const items = await loadIndex();
    const matched = items
      .map((item) => ({ item, value: score(item, terms) }))
      .filter((entry) => entry.value > 0)
      .sort((a, b) => b.value - a.value);

    const limit = SITE.searchResultLimit;
    results.replaceChildren(...matched.slice(0, limit).map((entry) => renderCard(entry.item, terms)));

    status.textContent =
      matched.length === 0
        ? TEXT.searchNoResult(query.trim())
        : TEXT.searchResult(matched.length, matched.length > limit ? limit : null);
  }

  let timer: number | undefined;
  input?.addEventListener('input', () => {
    window.clearTimeout(timer);
    const value = input.value;
    timer = window.setTimeout(() => void runSearch(value), 120);
  });

  // 支持 ?q=关键词 直接搜索
  const initial = new URLSearchParams(location.search).get('q');
  if (input && initial) {
    input.value = initial;
    void runSearch(initial);
  }

  // 按 / 聚焦搜索框（在输入框里按 / 不拦截）
  document.addEventListener('keydown', (event) => {
    if (event.key !== '/' || event.metaKey || event.ctrlKey) return;
    const target = event.target as HTMLElement | null;
    if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)) return;
    event.preventDefault();
    input?.focus();
  });
</script>
