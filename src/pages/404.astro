---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TEXT } from '../consts';
---

<BaseLayout title={TEXT.notFoundTitle} noindex>
  <div class="container section not-found">
    <p class="not-found__code">404</p>
    <h1 class="not-found__title">{TEXT.notFoundHeading}</h1>
    <p class="page-desc">{TEXT.notFoundDesc}</p>
    <p>
      <a href={import.meta.env.BASE_URL}>{TEXT.notFoundHome}</a>
      &nbsp;·&nbsp;
      <a href={import.meta.env.BASE_URL + 'search/'}>{TEXT.notFoundSearch}</a>
    </p>
  </div>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    padding-block: 5rem;
  }
  .not-found__code {
    font-size: 4.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--border-strong);
    margin-bottom: 0.5rem;
  }
  .not-found__title {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }
</style>
