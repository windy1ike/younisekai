---
/**
 * 阅读进度条
 *
 * 固定在视口最上方的一条细线，随阅读进度从左向右填充。
 *
 * 注意：这个组件必须放在「没有 transform 的祖先」下，所以它被挂到 base.astro
 * 的 <body> 里。grid.astro 的主内容容器上有 `transform: translateY(...)`，
 * 一旦放进去，position: fixed 会相对那个容器定位（等于跟着页面滚动跑掉），
 * 表现就是「根本看不到这条线」。
 *
 * 进度按「文章容器」计算（默认 #post-container）：容器顶部到达视口顶部时 0%，
 * 容器底部到达视口底部时 100%；找不到容器（首页等非文章页）则退化为整页滚动进度。
 */
---

<div
    class="reading-progress"
    id="reading-progress"
    data-article="#post-container"
    aria-hidden="true"
>
    <div class="reading-progress__bar"></div>
</div>

<style>
    .reading-progress {
        position: fixed;
        left: 0;
        right: 0;
        top: 0;
        height: 3px;
        /* 轨道：主色的淡色底，跟随 --hue 与亮/暗主题 */
        background: color-mix(in oklch, var(--primary) 18%, transparent);
        /* 盖在导航栏（z-50）之上，低于弹窗类浮层 */
        z-index: 200;
        pointer-events: none;
    }

    .reading-progress__bar {
        height: 100%;
        width: 0;
        background: var(--primary);
        transition: width 90ms linear;
    }

    @media (prefers-reduced-motion: reduce) {
        .reading-progress__bar {
            transition: none;
        }
    }
</style>

<script>
    let detach: (() => void) | null = null;

    function setupReadingProgress() {
        // 切页时先把上一次的监听摘掉，避免叠加
        if (detach) {
            detach();
            detach = null;
        }

        const bar = document.querySelector<HTMLElement>(
            ".reading-progress__bar",
        );
        const el = document.querySelector<HTMLElement>(".reading-progress");
        if (!bar || !el) return;

        const article = document.querySelector<HTMLElement>(
            el.dataset.article || "#post-container",
        );

        const update = () => {
            const scrollTop = window.scrollY || document.documentElement.scrollTop || 0;
            const viewport = window.innerHeight || document.documentElement.clientHeight;

            let progress: number;
            if (article) {
                // 文章容器在文档中的起点与高度
                const start = scrollTop + article.getBoundingClientRect().top;
                const total = article.offsetHeight - viewport;
                progress = total <= 8 ? 1 : (scrollTop - start) / total;
            } else {
                // 非文章页：整页滚动进度
                const total = document.documentElement.scrollHeight - viewport;
                progress = total <= 8 ? 1 : scrollTop / total;
            }

            progress = Math.min(1, Math.max(0, progress));
            bar.style.width = `${(progress * 100).toFixed(2)}%`;
        };

        const onScroll = () => window.requestAnimationFrame(update);
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);

        update();

        detach = () => {
            window.removeEventListener("scroll", onScroll);
            window.removeEventListener("resize", onScroll);
        };
    }

    setupReadingProgress();
    document.addEventListener("DOMContentLoaded", setupReadingProgress);
    window.addEventListener("load", setupReadingProgress);

    // Swup 无刷新切页后，文章容器换成了新的节点，需要重新找一次。
    // page:view 在内容替换并渲染完成之后触发，这时查 DOM 拿到的才是新节点。
    let swupBound = false;
    const bindSwup = () => {
        if (swupBound || !(window as any).swup?.hooks) return;
        (window as any).swup.hooks.on("page:view", () => {
            window.requestAnimationFrame(setupReadingProgress);
            setTimeout(setupReadingProgress, 320);
        });
        swupBound = true;
    };
    if ((window as any).swup?.hooks) bindSwup();
    else document.addEventListener("swup:enable", bindSwup);
</script>
