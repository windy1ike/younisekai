---
import type { Post } from '../utils/post';
import { excerpt, formatDate, postUrl, tagUrl, toISODate } from '../utils/post';
import { TEXT } from '../consts';

interface Props {
  post: Post;
  /** 列表页显示标签 */
  showTags?: boolean;
}

const { post, showTags = true } = Astro.props;
const { title, pubDate, tags, draft } = post.data;
---

<li class="post-card">
  <h2 class="post-card__title">
    <a href={postUrl(post)}>{title}</a>
  </h2>
  <p class="post-card__desc">{excerpt(post)}</p>
  <div class="post-meta">
    <time datetime={toISODate(pubDate)}>{formatDate(pubDate)}</time>
    {draft && <span class="draft-badge">{TEXT.draftBadge}</span>}
  </div>
  {
    showTags && tags.length > 0 && (
      <ul class="tag-list post-card__tags">
        {tags.map((tag) => (
          <li>
            <a class="tag" href={tagUrl(tag)}>
              {tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</li>
