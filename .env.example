# ==============================================================================
# younisekai 环境变量示例
#
# 用法：复制本文件为 .env（不要直接修改本示例文件），按需填写。
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# 部署到云端时，请到平台的环境变量设置里逐条添加（不要只依赖本地 .env）。
#
# 三种部署模式：
#   A. 纯静态部署（默认）
#      下面的变量全部留空。执行 npm run build 得到 dist/，可托管到
#      GitHub Pages、Cloudflare Pages、Netlify、对象存储、Docker 等。
#      后台页面仍会生成，但无法在线登录 —— 想改内容就直接编辑 src/content 下的文件，
#      或用本地写稿模式（见文末）。
#
#   B. 后台在线登录：Cloudflare Pages / Vercel / Netlify + 自带 OAuth（推荐）
#      1. 在 [GitHub → Developer settings → OAuth Apps] 新建一个 OAuth App：
#           Homepage URL               = 你的站点地址，例如 https://younisekai.pages.dev
#           Authorization callback URL = 你的站点地址 + /oauth/callback
#         注册后点 "Generate a new client secret"，记下 Client ID 与 Client Secret。
#      2. 在部署平台配置下面三个变量：
#           ENABLE_CMS_OAUTH=1
#           OAUTH_GITHUB_CLIENT_ID=...
#           OAUTH_GITHUB_CLIENT_SECRET=...
#         并根据实际域名设置 SITE_URL 与 BASE_PATH（见下）。
#      3. 把 .decap.yml 里的 site_domain / base_url / site_url / logo_url
#         改成你的真实域名（三处都要改，改完重新部署）。
#      4. 访问「站点地址 + /studio/」即可用 GitHub 账号登录写稿，
#         保存后会以 commit 的形式提交到仓库，CI 自动重新部署。
#
#   C. 自己服务器 / Docker：想要后台就在构建环境里放同样的变量。
#
# 本地写稿（不需要 OAuth、不需要联网认证）：
#   终端 1：npx decap-server
#   终端 2：npm run dev
#   浏览器打开：http://localhost:4321/studio/
# ==============================================================================

# ── 站点地址（影响 RSS / sitemap / canonical / 社交分享图，务必与真实地址一致）──
# 不设置时使用 younisekai.config.yaml 里的 site.siteURL
#   Cloudflare Pages / Vercel / 自定义域名（根路径）：https://xxx.pages.dev/
#   GitHub Pages 项目站点：                          https://<用户名>.github.io/<仓库名>/
SITE_URL=

# ── 部署基准路径（决定资源与站内链接的前缀）──
#   根路径部署（Cloudflare Pages / Vercel / 自定义域名）：/
#   GitHub Pages 项目站点：                              /<仓库名>/
# 不设置时使用 astro.config.mjs 里的默认值
BASE_PATH=

# ── 后台管理路由（不设置时默认 /studio）──
# 站点里不会出现任何指向它的链接；改成别的路径可以进一步降低被发现概率
ADMIN_ROUTE=

# ── 后台在线登录（Decap CMS OAuth）──
# 是否启用：留空 = 纯静态，不挂 SSR 适配器；1 = 启用（需要下面两项 + 支持 SSR 的平台）
ENABLE_CMS_OAUTH=

# GitHub OAuth 应用的 Client ID
OAUTH_GITHUB_CLIENT_ID=

# GitHub OAuth 应用的 Client Secret（务必保密，不要提交到仓库）
OAUTH_GITHUB_CLIENT_SECRET=

# 仅在改用 GitHub App（而非 OAuth App）时才需要：仓库数字 ID
# 获取方式：curl -s https://api.github.com/repos/<owner>/<repo> | jq .id
# OAUTH_GITHUB_REPO_ID=
