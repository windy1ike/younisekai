# ==============================================================================
# younisekai 环境变量示例
#
# 用法：复制本文件为 .env（不要直接修改本示例文件），按需填写。
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# 两种部署模式：
#   A. 纯静态部署（默认，推荐先用这个跑通）
#      本文件的变量全部留空/不设置，执行 npm run build 得到 dist/，
#      可托管到 GitHub Pages、Cloudflare Pages、Netlify、对象存储、Docker 等。
#      后台 /admin/ 仍可打开，但无法在线登录，请用编辑器直接改 src/content 下的文件。
#
#   B. 启用后台在线登录（Decap CMS OAuth，需要 SSR）
#      1. 到 GitHub → Settings → Developer settings → OAuth Apps → New OAuth App，
#         Homepage URL 填站点地址，Authorization callback URL 填
#         「站点地址 + /oauth/callback」（例如 https://your-domain.com/oauth/callback）；
#      2. 生成 Client Secret，把 Client ID / Client Secret 填到下面两个变量；
#      3. 把 ENABLE_CMS_OAUTH 设为 1
#         （astro.config.mjs 会据此启用 SSR 适配器与 OAuth 路由）；
#      4. 部署到支持 SSR 的平台（Vercel / Netlify / Cloudflare 等），
#         并在平台的环境变量设置里导入这三个变量（不要只依赖本地 .env）；
#      5. 核对 .decap.yml 中的 backend.repo / branch / site_domain / base_url
#         已改成自己的信息。
#      注意：GitHub Pages 只支持纯静态托管，无法用于模式 B。
# ==============================================================================

# GitHub OAuth 应用的 Client ID
OAUTH_GITHUB_CLIENT_ID=

# GitHub OAuth 应用的 Client Secret（务必保密，不要提交到仓库）
OAUTH_GITHUB_CLIENT_SECRET=

# 是否启用 Decap CMS OAuth
#   留空 / 不设置：纯静态部署，不启用 SSR 适配器与 OAuth 路由
#   1：启用后台在线登录（需要上面两项，并部署到支持 SSR 的平台）
ENABLE_CMS_OAUTH=
